<Window x:Class="StudentRegistrationApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Student Registration" Height="760" Width="1150"
        WindowStartupLocation="CenterScreen" Background="#F1F5F9" FontFamily="Segoe UI"
        Loaded="Window_Loaded">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ===== HEADER ===== -->
        <Border Grid.Row="0" Background="{StaticResource Primer}" CornerRadius="8" Padding="20,14" Margin="0,0,0,14">
            <StackPanel>
                <TextBlock Text="🎓 Student Registration" FontSize="22" FontWeight="Bold" Foreground="White"/>
                <TextBlock Text="Data dari database StudentRegistrationDB (SQL Server) via ADO.NET" Foreground="#DBEAFE" Margin="0,2,0,0"/>
            </StackPanel>
        </Border>

        <!-- ===== KARTU RINGKASAN ===== -->
        <UniformGrid Grid.Row="1" Columns="4" Margin="0,0,0,14">
            <UniformGrid.Resources>
                <Style TargetType="Border">
                    <Setter Property="Background" Value="White"/>
                    <Setter Property="CornerRadius" Value="8"/>
                    <Setter Property="Padding" Value="16,10"/>
                    <Setter Property="BorderBrush" Value="#E2E8F0"/>
                    <Setter Property="BorderThickness" Value="1"/>
                    <Setter Property="Margin" Value="0,0,12,0"/>
                </Style>
            </UniformGrid.Resources>
            <Border>
                <StackPanel>
                    <TextBlock Text="Mahasiswa" Foreground="#64748B"/>
                    <TextBlock x:Name="lblMahasiswa" Text="-" FontSize="26" FontWeight="Bold" Foreground="#2563EB"/>
                </StackPanel>
            </Border>
            <Border>
                <StackPanel>
                    <TextBlock Text="Program Studi" Foreground="#64748B"/>
                    <TextBlock x:Name="lblProdi" Text="-" FontSize="26" FontWeight="Bold" Foreground="#7C3AED"/>
                </StackPanel>
            </Border>
            <Border>
                <StackPanel>
                    <TextBlock Text="Mata Kuliah" Foreground="#64748B"/>
                    <TextBlock x:Name="lblMatkul" Text="-" FontSize="26" FontWeight="Bold" Foreground="#0891B2"/>
                </StackPanel>
            </Border>
            <Border Margin="0">
                <StackPanel>
                    <TextBlock Text="Registrasi Aktif" Foreground="#64748B"/>
                    <TextBlock x:Name="lblRegistrasi" Text="-" FontSize="26" FontWeight="Bold" Foreground="#16A34A"/>
                </StackPanel>
            </Border>
        </UniformGrid>

        <!-- ===== FILTER ===== -->
        <Border Grid.Row="2" Background="White" CornerRadius="8" Padding="16,12" BorderBrush="#E2E8F0" BorderThickness="1" Margin="0,0,0,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="230"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="210"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text="Tampilkan" VerticalAlignment="Center" FontWeight="SemiBold" Margin="0,0,8,0"/>
                <ComboBox Grid.Column="1" x:Name="cmbTampilan" SelectionChanged="Filter_Changed"
                          AutomationProperties.AutomationId="cmbTampilan"/>

                <TextBlock Grid.Column="2" Text="Prodi" VerticalAlignment="Center" FontWeight="SemiBold" Margin="16,0,8,0"/>
                <ComboBox Grid.Column="3" x:Name="cmbProdi" DisplayMemberPath="Value" SelectedValuePath="Key"
                          SelectionChanged="Filter_Changed" AutomationProperties.AutomationId="cmbProdi"/>

                <TextBlock Grid.Column="4" Text="🔍" VerticalAlignment="Center" FontSize="15" Margin="16,0,8,0"/>
                <TextBox Grid.Column="5" x:Name="txtCari" TextChanged="Filter_Changed"
                         ToolTip="Cari NIM, nama, atau mata kuliah" AutomationProperties.AutomationId="txtCari"/>

                <Button Grid.Column="6" Content="⟳ Muat Ulang" Style="{StaticResource Tombol}" Margin="12,0,0,0"
                        Click="BtnMuatUlang_Click" AutomationProperties.AutomationId="btnMuatUlang"/>
            </Grid>
        </Border>

        <!-- ===== DATAGRID ===== -->
        <Border Grid.Row="3" Background="White" CornerRadius="8" Padding="16" BorderBrush="#E2E8F0" BorderThickness="1">
            <DataGrid x:Name="dgData" AutoGenerateColumns="True" IsReadOnly="True" CanUserAddRows="False"
                      HeadersVisibility="Column" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#E2E8F0"
                      BorderBrush="#E2E8F0" RowHeight="30" AlternatingRowBackground="#F8FAFC"
                      ColumnWidth="Auto" AutomationProperties.AutomationId="dgData">
                <DataGrid.ColumnHeaderStyle>
                    <Style TargetType="DataGridColumnHeader">
                        <Setter Property="Background" Value="#EFF6FF"/>
                        <Setter Property="Foreground" Value="#1E3A8A"/>
                        <Setter Property="FontWeight" Value="SemiBold"/>
                        <Setter Property="Padding" Value="10,7"/>
                    </Style>
                </DataGrid.ColumnHeaderStyle>
                <DataGrid.CellStyle>
                    <Style TargetType="DataGridCell">
                        <Setter Property="Padding" Value="10,0"/>
                        <Setter Property="BorderThickness" Value="0"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="DataGridCell">
                                    <Border Padding="{TemplateBinding Padding}" Background="{TemplateBinding Background}">
                                        <ContentPresenter VerticalAlignment="Center"/>
                                    </Border>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </DataGrid.CellStyle>
            </DataGrid>
        </Border>

        <!-- ===== STATUS BAR ===== -->
        <TextBlock Grid.Row="4" x:Name="lblStatus" Margin="4,10,0,0" Foreground="#64748B"
                   AutomationProperties.AutomationId="lblStatus"/>
    </Grid>
</Window>
