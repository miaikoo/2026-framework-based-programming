<Window x:Class="StudentManagement.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:StudentManagement.ViewModels"
        Title="Student Management System" Height="800" Width="1150"
        WindowStartupLocation="CenterScreen" Background="#F1F5F9" FontFamily="Segoe UI">

    <!-- Menghubungkan View ke ViewModel -->
    <Window.DataContext>
        <vm:MainViewModel/>
    </Window.DataContext>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ===== HEADER ===== -->
        <Border Grid.Row="0" Background="{StaticResource Primer}" CornerRadius="8" Padding="20,14" Margin="0,0,0,14">
            <StackPanel>
                <TextBlock Text="🎓 Student Management System" FontSize="22" FontWeight="Bold" Foreground="White"/>
                <TextBlock Text="WPF .NET 8 · MVVM · SQL Server (ADO.NET)" Foreground="#DBEAFE" Margin="0,2,0,0"/>
            </StackPanel>
        </Border>

        <!-- ===== STATISTIK ===== -->
        <Grid Grid.Row="1" Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="2*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource Kartu}">
                <StackPanel>
                    <TextBlock Text="Total Mahasiswa" Foreground="#64748B"/>
                    <TextBlock Text="{Binding Total}" FontSize="28" FontWeight="Bold" Foreground="#2563EB"/>
                </StackPanel>
            </Border>
            <Border Grid.Column="2" Style="{StaticResource Kartu}">
                <StackPanel>
                    <TextBlock Text="Laki-laki" Foreground="#64748B"/>
                    <TextBlock Text="{Binding JumlahLaki}" FontSize="28" FontWeight="Bold" Foreground="#0891B2"/>
                </StackPanel>
            </Border>
            <Border Grid.Column="4" Style="{StaticResource Kartu}">
                <StackPanel>
                    <TextBlock Text="Perempuan" Foreground="#64748B"/>
                    <TextBlock Text="{Binding JumlahPerempuan}" FontSize="28" FontWeight="Bold" Foreground="#DB2777"/>
                </StackPanel>
            </Border>
            <Border Grid.Column="6" Style="{StaticResource Kartu}">
                <StackPanel>
                    <TextBlock Text="Per Jurusan" Foreground="#64748B" Margin="0,0,0,4"/>
                    <ItemsControl ItemsSource="{Binding StatistikJurusan}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="#EFF6FF" CornerRadius="10" Padding="8,2" Margin="0,2,6,2">
                                    <TextBlock Foreground="#1E3A8A">
                                        <Run Text="{Binding Jurusan, Mode=OneWay}"/>
                                        <Run Text="·" Foreground="#94A3B8"/>
                                        <Run Text="{Binding Jumlah, Mode=OneWay}" FontWeight="Bold"/>
                                    </TextBlock>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </Grid>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="420"/>
                <ColumnDefinition Width="14"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- ===== FORMULIR ===== -->
            <Border Grid.Column="0" Style="{StaticResource Kartu}" Padding="20">
                <StackPanel>
                    <TextBlock Text="Data Mahasiswa" FontSize="16" FontWeight="Bold"/>

                    <TextBlock Text="NIM" Style="{StaticResource Label}"/>
                    <TextBox Text="{Binding Nim, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.AutomationId="txtNim"/>

                    <TextBlock Text="Nama" Style="{StaticResource Label}"/>
                    <TextBox Text="{Binding Nama, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.AutomationId="txtNama"/>

                    <TextBlock Text="Jurusan" Style="{StaticResource Label}"/>
                    <ComboBox ItemsSource="{Binding DaftarJurusan}" SelectedItem="{Binding Jurusan}"
                              AutomationProperties.AutomationId="cmbJurusan"/>

                    <TextBlock Text="Gender" Style="{StaticResource Label}"/>
                    <StackPanel Orientation="Horizontal">
                        <RadioButton Content="Laki-laki" GroupName="G" IsChecked="{Binding IsLaki}" Margin="0,0,20,0"
                                     AutomationProperties.AutomationId="rbLaki"/>
                        <RadioButton Content="Perempuan" GroupName="G" IsChecked="{Binding IsPerempuan}"
                                     AutomationProperties.AutomationId="rbPerempuan"/>
                    </StackPanel>

                    <TextBlock Text="Email" Style="{StaticResource Label}"/>
                    <TextBox Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.AutomationId="txtEmail"/>

                    <!-- Pesan: merah jika error, hijau jika sukses -->
                    <TextBlock Text="{Binding Pesan}" Margin="0,14,0,0" TextWrapping="Wrap" FontWeight="SemiBold"
                               AutomationProperties.AutomationId="lblPesan">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="#16A34A"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding PesanError}" Value="True">
                                        <Setter Property="Foreground" Value="#DC2626"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                    <WrapPanel Margin="0,14,0,0">
                        <Button Content="Tambah" Command="{Binding TambahCommand}" Style="{StaticResource Tombol}"
                                Background="{StaticResource Primer}" Foreground="White" AutomationProperties.AutomationId="btnTambah"/>
                        <Button Content="Ubah" Command="{Binding UbahCommand}" Style="{StaticResource Tombol}"
                                Background="#F59E0B" Foreground="White" AutomationProperties.AutomationId="btnUbah"/>
                        <Button Content="Hapus" Command="{Binding HapusCommand}" Style="{StaticResource Tombol}"
                                Background="#DC2626" Foreground="White" AutomationProperties.AutomationId="btnHapus"/>
                        <Button Content="Bersihkan" Command="{Binding BersihkanCommand}" Style="{StaticResource Tombol}"
                                Background="#E2E8F0" Foreground="#334155" Margin="0" AutomationProperties.AutomationId="btnBersihkan"/>
                    </WrapPanel>
                </StackPanel>
            </Border>

            <!-- ===== TABEL + PENCARIAN ===== -->
            <Border Grid.Column="2" Style="{StaticResource Kartu}" Padding="20">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <DockPanel Grid.Row="0" Margin="0,0,0,10">
                        <TextBlock Text="🔍" VerticalAlignment="Center" FontSize="16" Margin="0,0,8,0"/>
                        <TextBox Text="{Binding Cari, UpdateSourceTrigger=PropertyChanged}"
                                 ToolTip="Cari berdasarkan NIM, nama, jurusan, atau email"
                                 AutomationProperties.AutomationId="txtCari"/>
                    </DockPanel>

                    <DataGrid Grid.Row="1" ItemsSource="{Binding Students}" SelectedItem="{Binding SelectedStudent}"
                              AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"
                              HeadersVisibility="Column" GridLinesVisibility="Horizontal" SelectionMode="Single"
                              HorizontalGridLinesBrush="#E2E8F0" BorderBrush="#E2E8F0" RowHeight="30"
                              AlternatingRowBackground="#F8FAFC" AutomationProperties.AutomationId="dgStudents">
                        <DataGrid.ColumnHeaderStyle>
                            <Style TargetType="DataGridColumnHeader">
                                <Setter Property="Background" Value="#EFF6FF"/>
                                <Setter Property="Foreground" Value="#1E3A8A"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                                <Setter Property="Padding" Value="8,6"/>
                            </Style>
                        </DataGrid.ColumnHeaderStyle>
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="NIM" Binding="{Binding Nim}" Width="100"/>
                            <DataGridTextColumn Header="Nama" Binding="{Binding Nama}" Width="*"/>
                            <DataGridTextColumn Header="Jurusan" Binding="{Binding Jurusan}" Width="*"/>
                            <DataGridTextColumn Header="Gender" Binding="{Binding Gender}" Width="85"/>
                            <DataGridTextColumn Header="Email" Binding="{Binding Email}" Width="1.2*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
