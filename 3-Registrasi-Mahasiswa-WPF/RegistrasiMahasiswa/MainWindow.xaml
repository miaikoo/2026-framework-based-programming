<Window x:Class="RegistrasiMahasiswa.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Registrasi Mahasiswa" Height="830" Width="1000"
        WindowStartupLocation="CenterScreen" Background="#F1F5F9"
        FontFamily="Segoe UI">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ===== HEADER ===== -->
        <Border Grid.Row="0" Background="{StaticResource Primer}" CornerRadius="8" Padding="20,14" Margin="0,0,0,16">
            <StackPanel>
                <TextBlock Text="🎓 Registrasi Mahasiswa Baru" FontSize="22" FontWeight="Bold" Foreground="White"/>
                <TextBlock Text="Isi formulir di bawah ini dengan data yang benar" Foreground="#DBEAFE" Margin="0,2,0,0"/>
            </StackPanel>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="380"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- ===== KIRI: FORMULIR ===== -->
            <Border Grid.Column="0" Background="White" CornerRadius="8" Padding="20" BorderBrush="#E2E8F0" BorderThickness="1">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="Formulir Pendaftaran" FontSize="16" FontWeight="Bold"/>

                        <TextBlock Text="NIM" Style="{StaticResource Label}"/>
                        <TextBox x:Name="txtNim" MaxLength="12" AutomationProperties.AutomationId="txtNim"/>

                        <TextBlock Text="Nama Lengkap" Style="{StaticResource Label}"/>
                        <TextBox x:Name="txtNama" AutomationProperties.AutomationId="txtNama"/>

                        <TextBlock Text="Email" Style="{StaticResource Label}"/>
                        <TextBox x:Name="txtEmail" AutomationProperties.AutomationId="txtEmail"/>

                        <TextBlock Text="Program Studi" Style="{StaticResource Label}"/>
                        <ComboBox x:Name="cmbProdi" AutomationProperties.AutomationId="cmbProdi">
                            <ComboBoxItem Content="Teknik Informatika"/>
                            <ComboBoxItem Content="Sistem Informasi"/>
                            <ComboBoxItem Content="Teknologi Informasi"/>
                            <ComboBoxItem Content="Rekayasa Perangkat Lunak"/>
                            <ComboBoxItem Content="Sains Data"/>
                        </ComboBox>

                        <TextBlock Text="Jenis Kelamin" Style="{StaticResource Label}"/>
                        <StackPanel Orientation="Horizontal">
                            <RadioButton x:Name="rbLaki" Content="Laki-laki" GroupName="JK" Margin="0,0,20,0" AutomationProperties.AutomationId="rbLaki"/>
                            <RadioButton x:Name="rbPerempuan" Content="Perempuan" GroupName="JK" AutomationProperties.AutomationId="rbPerempuan"/>
                        </StackPanel>

                        <TextBlock Text="Tanggal Lahir" Style="{StaticResource Label}"/>
                        <DatePicker x:Name="dpTanggalLahir" FontSize="14" AutomationProperties.AutomationId="dpTanggalLahir"/>

                        <TextBlock Text="Alamat" Style="{StaticResource Label}"/>
                        <TextBox x:Name="txtAlamat" Height="60" TextWrapping="Wrap" AcceptsReturn="True"
                                 VerticalScrollBarVisibility="Auto" AutomationProperties.AutomationId="txtAlamat"/>

                        <CheckBox x:Name="chkSetuju" Margin="0,14,0,0" AutomationProperties.AutomationId="chkSetuju">
                            <TextBlock Text="Saya menyatakan data yang diisi sudah benar" TextWrapping="Wrap"/>
                        </CheckBox>

                        <!-- Pesan error / sukses -->
                        <TextBlock x:Name="lblPesan" Margin="0,12,0,0" TextWrapping="Wrap" FontWeight="SemiBold"
                                   AutomationProperties.AutomationId="lblPesan"/>

                        <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                            <Button x:Name="btnDaftar" Content="Daftar" Style="{StaticResource Tombol}"
                                    Background="{StaticResource Primer}" Foreground="White"
                                    Click="BtnDaftar_Click" AutomationProperties.AutomationId="btnDaftar"/>
                            <Button x:Name="btnReset" Content="Reset" Style="{StaticResource Tombol}"
                                    Background="#E2E8F0" Foreground="#334155" Margin="10,0,0,0"
                                    Click="BtnReset_Click" AutomationProperties.AutomationId="btnReset"/>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- ===== KANAN: DAFTAR MAHASISWA ===== -->
            <Border Grid.Column="2" Background="White" CornerRadius="8" Padding="20" BorderBrush="#E2E8F0" BorderThickness="1">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" x:Name="lblJumlah" Text="Mahasiswa Terdaftar (0)" FontSize="16" FontWeight="Bold" Margin="0,0,0,10"/>

                    <DataGrid Grid.Row="1" x:Name="dgMahasiswa" AutoGenerateColumns="False" IsReadOnly="True"
                              CanUserAddRows="False" HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                              HorizontalGridLinesBrush="#E2E8F0" BorderBrush="#E2E8F0" RowHeight="30"
                              AlternatingRowBackground="#F8FAFC" SelectionMode="Single"
                              AutomationProperties.AutomationId="dgMahasiswa">
                        <DataGrid.ColumnHeaderStyle>
                            <Style TargetType="DataGridColumnHeader">
                                <Setter Property="Background" Value="#EFF6FF"/>
                                <Setter Property="Foreground" Value="#1E3A8A"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                                <Setter Property="Padding" Value="8,6"/>
                            </Style>
                        </DataGrid.ColumnHeaderStyle>
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="NIM" Binding="{Binding NIM}" Width="90"/>
                            <DataGridTextColumn Header="Nama" Binding="{Binding Nama}" Width="*"/>
                            <DataGridTextColumn Header="Prodi" Binding="{Binding Prodi}" Width="*"/>
                            <DataGridTextColumn Header="JK" Binding="{Binding JenisKelamin}" Width="80"/>
                            <DataGridTextColumn Header="Tgl Lahir" Binding="{Binding TanggalLahirTeks}" Width="85"/>
                        </DataGrid.Columns>
                    </DataGrid>

                    <Button Grid.Row="2" x:Name="btnHapus" Content="Hapus Data Terpilih" Style="{StaticResource Tombol}"
                            Background="#FEE2E2" Foreground="#B91C1C" HorizontalAlignment="Right" Margin="0,12,0,0"
                            Click="BtnHapus_Click" AutomationProperties.AutomationId="btnHapus"/>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
